#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="{{ db_stack_backup_dir }}"
DAYS_TO_KEEP=7
TIMESTAMP="$(date +%F_%H-%M-%S)"
FILE="${BACKUP_DIR}/backup_${TIMESTAMP}.sql.gz"

mkdir -p "${BACKUP_DIR}"

docker exec db_postgres pg_dump \
  -U "{{ db_stack_pg_user }}" \
  "{{ db_stack_pg_db }}" | gzip > "${FILE}"

find "${BACKUP_DIR}" -type f -name "backup_*.sql.gz" -mtime +${DAYS_TO_KEEP} -delete

echo "{\"status\": \"ok\", \"backup_file\": \"${FILE}\"}"
