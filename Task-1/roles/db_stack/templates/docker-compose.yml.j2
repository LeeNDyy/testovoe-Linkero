services:
  postgres:
    image: "postgres:{{ db_stack_pg_version }}"
    hostname: postgres
    environment:
      POSTGRES_USER: "{{ db_stack_pg_user }}"
      POSTGRES_PASSWORD: "{{ db_stack_pg_password }}"
      POSTGRES_DB: "{{ db_stack_pg_db }}"
      POSTGRES_HOST_AUTH_METHOD: md5  
    volumes:
      - pgdata:/var/lib/postgresql/data
      - "./init-db.sql:/docker-entrypoint-initdb.d/01-init.sql:ro"
    networks:
      - db_net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_stack_pg_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  pgbouncer:
    image: edoburu/pgbouncer:latest
    hostname: pgbouncer
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - "./pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini:ro"
      - "./userlist.txt:/etc/pgbouncer/userlist.txt:ro"
    ports:
      - "127.0.0.1:6432:6432"
    networks:
      - db_net
    healthcheck:
      test: ["CMD", "pg_isready", "-h", "postgres", "-U", "{{ db_stack_pg_user }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s

networks:
  db_net:
    driver: bridge
volumes:
  pgdata:
